rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Deny all client SDK access. The backend uses the service account.
    match /{document=**} {
      allow read, write: if false;
    }

    // Explicit deny for super-admin instruction collections (documentation).
    match /superadmin_instructions/{instructionId} {
      allow read, write: if false;
      match /versions/{versionId} {
        allow read, write: if false;
      }
    }
    match /superadmin_remarks/{remarkId} {
      allow read, write: if false;
    }
    match /superadmin_meta/{docId} {
      allow read, write: if false;
    }
    // Chat logs (and their messages) are backend-only; reviewers read them through the API.
    match /chat_logs/{logId} {
      allow read, write: if false;
      match /{document=**} {
        allow read, write: if false;
      }
    }
  }
}
