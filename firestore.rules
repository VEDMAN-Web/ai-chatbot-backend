rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Deny all client SDK access. The API uses the Firestore service account.
    match /{document=**} {
      allow read, write: if false;
    }

    // Super-admin instructions are backend-only (explicit deny kept for clarity).
    match /superadmin_instructions/{instructionId} {
      allow read, write: if false;
      match /versions/{versionId} {
        allow read, write: if false;
      }
    }
    match /superadmin_remarks/{remarkId} {
      allow read, write: if false;
    }
    match /superadmin_meta/{docId} {
      allow read, write: if false;
    }
  }
}
