# ==============================================================================
# AI Property Chatbot & Admin Platform - Environment Configuration Reference
# ==============================================================================
# Each variable is documented with a 1-line description explaining its purpose.
# Copy this file to .env and configure the values for your environment.

# ------------------------------------------------------------------------------
# 1. Environment & Server Runtime
# ------------------------------------------------------------------------------
# Runtime environment: "development", "staging", or "production"
ENVIRONMENT=development
# Server HTTP listening port (assigned automatically on Cloud Run / Railway)
PORT=8000
# Python application log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
APP_LOG_LEVEL=INFO
# If true, enables OpenAPI / Swagger UI docs at /docs and /redoc
ENABLE_API_DOCS=false
# If true, trusts incoming proxy headers (e.g. behind Cloud Run / reverse proxies)
TRUST_PROXY_HEADERS=false
# Comma-separated trusted upstream proxy IPs or subnets for uvicorn (defaults to 127.0.0.1)
FORWARDED_ALLOW_IPS=127.0.0.1
# Whether uvicorn should parse proxy headers: "true" or "false"
PROXY_HEADERS=true

# ------------------------------------------------------------------------------
# 2. Security, Authentication & Rate Limiting
# ------------------------------------------------------------------------------
# Internal HMAC secret for signing password reset tokens, OAuth state and report download links (min 16 chars)
INTERNAL_API_SECRET=your-random-32-byte-secret-token-here
# Legacy or fallback JWT signing key
SECRET_KEY=
# Fallback email for default admin user bootstrapping
ADMIN_EMAIL=admin@varsoviaestate.com
# Initial password for seeded admin user (change immediately after deployment)
ADMIN_PASSWORD=ChangeMe#Admin12345
# Number of hours before admin session tokens expire (default: 168 = 7 days)
SESSION_EXPIRE_HOURS=168
# In development/testing only: include password reset token directly in API response
EXPOSE_RESET_TOKEN_IN_RESPONSE=false
# In development/testing only: allows bypass of strict auth checks for local debugging
ALLOW_INSECURE_DEV_AUTH=false
# Disallow hard deletes of properties across all APIs (enforces soft-delete archiving)
ALLOW_HARD_DELETE=false
# Number of days to retain undo snapshots for admin modifications
ADMIN_SNAPSHOT_RETENTION_DAYS=6
# Time-to-live in minutes for staged admin pending actions
ADMIN_PENDING_ACTION_TTL_MIN=30
# Expiration time in minutes for sensitive pending actions
ACTION_EXPIRATION_MINUTES=30
# JSON array of origins permitted for Cross-Origin Resource Sharing (CORS)
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8000","https://tajlandia.com","https://tajlandia.pl","https://thai.estate","https://varsoviaestate.com"]
# Alternative comma-separated string of allowed CORS origins
CORS_ALLOWED_ORIGINS=
# Allow all origins (development only; never enable in production)
CORS_ALLOW_ALL=false
# Force rate limits even in test environments: "1" or "0"
ENFORCE_RATE_LIMITS=0
# Max login attempts within the rate-limit window
RATE_LIMIT_LOGIN_ATTEMPTS=10
# Rate limit window in seconds for login attempts (900s = 15m)
RATE_LIMIT_LOGIN_WINDOW_SEC=900
# Max password reset requests allowed within window
RATE_LIMIT_RESET_ATTEMPTS=5
# Rate limit window in seconds for password resets (3600s = 1h)
RATE_LIMIT_RESET_WINDOW_SEC=3600
# Max public chat queries per IP/session per window
RATE_LIMIT_PUBLIC_CHAT=60
# Public chat rate limit window in seconds
RATE_LIMIT_PUBLIC_CHAT_WINDOW_SEC=60
# Max admin chat messages allowed per user within window
RATE_LIMIT_ADMIN_CHAT=30
# Admin chat rate limit window in seconds
RATE_LIMIT_ADMIN_CHAT_WINDOW_SEC=60
# Max write operations (property create/update/delete) per window
RATE_LIMIT_ADMIN_WRITE=30
# Admin write rate limit window in seconds
RATE_LIMIT_ADMIN_WRITE_WINDOW_SEC=60
# Max bulk import and superadmin operations per window
RATE_LIMIT_IMPORT_AND_SUPERADMIN=20
# Bulk import rate limit window in seconds
RATE_LIMIT_IMPORT_WINDOW_SEC=60

# ------------------------------------------------------------------------------
# 3. LLM Providers: Anthropic (Admin Intelligence & Primary Chatbot)
# ------------------------------------------------------------------------------
# API key for Anthropic Claude models
ANTHROPIC_API_KEY=sk-ant-api03-your-anthropic-key
# Primary Anthropic model used for complex reasoning, admin tools, and public agent
ANTHROPIC_MODEL=claude-opus-5-5
# Sampling temperature for Anthropic LLM (0.0 for strict, deterministic output)
ANTHROPIC_TEMPERATURE=0.0
# Request timeout in seconds for Anthropic API calls
ANTHROPIC_TIMEOUT=60.0
# Number of retry attempts on Anthropic API errors or rate limits
ANTHROPIC_MAX_RETRIES=1
# Fast lightweight Claude model used for fast intent classification and admin helpers
ADMIN_FAST_MODEL=claude-haiku-4-5
# Model used for main admin tool execution and generation
ADMIN_MAIN_MODEL=
# Request timeout in seconds for fast admin helper operations
ADMIN_HELPER_TIMEOUT=30.0
# Request timeout in seconds for main admin agent turns
ADMIN_MAIN_TIMEOUT=60.0
# Hard budget cap in seconds for a complete multi-round admin agent turn
ADMIN_TURN_BUDGET_SEC=75.0
# Max tokens for standard admin responses
ADMIN_NORMAL_MAX_TOKENS=700
# Max tokens for listing tables and inventory exports in admin chat
ADMIN_LIST_MAX_TOKENS=2000
# Maximum number of iterative tool calling rounds per admin request
ADMIN_MAX_TOOL_ROUNDS=3
# Cache TTL in seconds for admin tool query results
ADMIN_TOOL_CACHE_TTL_SEC=60.0
# Enable smart intent routing for incoming admin messages
ADMIN_SMART_INTENT_ENABLED=true
# Max smart intent LLM classifications per minute
ADMIN_SMART_INTENT_PER_MINUTE=20
# Timeout in seconds for smart intent classification call
ADMIN_SMART_INTENT_TIMEOUT_SEC=5.0
# Minimum confidence threshold (0.0 to 1.0) required to route via smart intent
ADMIN_SMART_INTENT_MIN_CONFIDENCE=0.6
# Log detailed latency timing breakdown for admin tool executions
ADMIN_DEBUG_TIMING=false

# ------------------------------------------------------------------------------
# 4. Embeddings & Semantic Search Configuration
# ------------------------------------------------------------------------------
# Model identifier for vector search embeddings
EMBEDDING_MODEL=text-embedding-3-small

# ------------------------------------------------------------------------------
# 5. Public Chatbot Parameters & Conversation Memory
# ------------------------------------------------------------------------------
# Sampling temperature for factual answers in public chatbot
PUBLIC_LLM_FACTUAL_TEMPERATURE=0.2
# Number of previous user turns sent to public agent for conversational context
PUBLIC_LLM_HISTORY_USER_TURNS=3
# Maximum total message count retained in conversation memory
SESSION_MEMORY_MESSAGES=220
# Maximum customer messages permitted per session before suggesting human contact
MAX_USER_MESSAGES_PER_SESSION=50
# Max character length for customer context summary
PROPERTY_CONTEXT_SUMMARY_CHARS=4000
# Save leads captured from visitor chat conversations and direct contact forms
ENABLE_LEAD_SAVING=true
# Save visitor chat transcripts to Firestore chat_logs collection
ENABLE_CHAT_LOGGING=false
# Dedicated storage flag for chat logs collection
ENABLE_CHAT_LOG_STORE=true
# Log admin conversations to chat logs
ADMIN_CHAT_LOGGING=true
# Days to retain chat log records before expiration
CHAT_LOG_RETENTION_DAYS=180
# Automatically mask emails and phone numbers in stored chat logs
CHAT_LOG_MASK_PII=true
# Enable taught answer corrections and superadmin instructions in chat
ENABLE_ANSWER_CORRECTIONS=true
# Semantic similarity threshold (0.0 to 1.0) to trigger a taught correction
CORRECTION_MATCH_THRESHOLD=0.88
# Cache duration in seconds for Firestore property catalog in memory
CATALOG_CACHE_TTL_SEC=900.0
# Cache duration in seconds for fuzzy property name index
NAME_INDEX_TTL_SEC=600.0
# Currency conversion rate from USD to Thai Baht
FX_USD_THB=35.0
# Currency conversion rate from EUR to Thai Baht
FX_EUR_THB=38.0

# ------------------------------------------------------------------------------
# 6. Google Cloud & Firebase Firestore Datastore
# ------------------------------------------------------------------------------
# Primary Google Cloud project ID for Firestore database
FIRESTORE_PROJECT_ID=varsovia-8c135
# Firestore database instance name (default is "(default)")
FIRESTORE_DATABASE=(default)
# Base64-encoded Firebase Service Account JSON credentials string
FIREBASE_SERVICE_ACCOUNT_KEY=
# Path to local Firebase Service Account JSON file (used if key string is unset)
FIREBASE_CREDENTIALS_PATH=credentials/firebase_service_account.json
# Enable live Firestore synchronization for property listings and memory
ENABLE_FIRESTORE_SYNC=true
# Target Firestore store for admin system prompts and instructions ("admin" or "user")
INSTRUCTIONS_FIRESTORE_TARGET=user
# Local emulator host:port for offline testing (e.g. "localhost:8080")
FIRESTORE_EMULATOR_HOST=
# Safety check: set to "1" or "true" to allow tests to write to live Firestore
ALLOW_LIVE_FIRESTORE=false

# --- Dedicated Admin Firestore Store (Optional: defaults to primary if omitted) ---
# Separate Google Cloud project ID for admin data and audit logs
ADMIN_FIRESTORE_PROJECT_ID=
# Database instance name for admin Firestore
ADMIN_FIRESTORE_DATABASE=
# Base64-encoded Service Account JSON credentials for admin Firestore
ADMIN_FIREBASE_SERVICE_ACCOUNT_KEY=
# File path to Service Account JSON for admin Firestore
ADMIN_FIREBASE_CREDENTIALS_PATH=
# Override Firestore sync specifically for the admin agent
ADMIN_ENABLE_FIRESTORE_SYNC=true

# --- Dedicated User/Public Firestore Store (Optional: defaults to primary if omitted) ---
# Separate Google Cloud project ID for public listings and visitor data
USER_FIRESTORE_PROJECT_ID=
# Database instance name for public user Firestore
USER_FIRESTORE_DATABASE=
# Base64-encoded Service Account JSON credentials for user Firestore
USER_FIREBASE_SERVICE_ACCOUNT_KEY=
# File path to Service Account JSON for user Firestore
USER_FIREBASE_CREDENTIALS_PATH=
# Override Firestore sync specifically for the public chatbot
USER_ENABLE_FIRESTORE_SYNC=true

# ------------------------------------------------------------------------------
# 7. Multi-Tenant Website Branding & Origin Defaults
# ------------------------------------------------------------------------------
# Full base URL of the primary customer-facing website
BASE_WEBSITE_URL=https://varsoviaestate.com/en
# Default tenant website identifier: "varsoviaestate.com", "tajlandia.com", or "thai.estate"
DEFAULT_TENANT=varsoviaestate.com
# Default site domain origin for requests lacking an Origin or Referer header
SITE_ORIGIN=varsoviaestate.com
# Display brand name used in messages, brochures and emails
BRAND_NAME=Varsovia Estate
# AI Chatbot assistant persona display name
BOT_NAME=Varsovia Estate Advisor
# Brand title header displayed in web clients and PDF dossiers
BRAND_TITLE=Varsovia Estate — Premium Thailand Properties
# Brand subtitle displayed beneath brand title
BRAND_SUBTITLE=Exclusive Estates
# Contact email for property advisor displayed to customers
ADVISOR_EMAIL=advisor@varsoviaestate.com
# General inquiries and lead notifications recipient email
SALES_EMAIL=sales@varsoviaestate.com
# Enforce strict multi-tenant property data separation between website domains
ENFORCE_TENANT_ISOLATION=false

# ------------------------------------------------------------------------------
# 8. External Integrations: Google Maps & Workspace (OAuth / SMTP)
# ------------------------------------------------------------------------------
# Google Maps API key with Maps JavaScript, Maps Embed, and Places API enabled
GOOGLE_MAPS_API_KEY=AIzaSy_your_google_maps_api_key
# Google Workspace OAuth2 client ID for Gmail & Calendar API access
GOOGLE_CLIENT_ID=
# Google Workspace OAuth2 client secret
GOOGLE_CLIENT_SECRET=
# Authorized redirect URI registered in Google Cloud OAuth credentials screen
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
# Fallback to shared server Google credentials if per-user OAuth token is absent
GOOGLE_SHARED_CREDENTIAL_FALLBACK=false
# Standard outgoing SMTP server hostname (e.g. smtp.gmail.com)
SMTP_HOST=smtp.gmail.com
# SMTP port (587 for STARTTLS, 465 for SSL)
SMTP_PORT=587
# SMTP account username or sender email address
SMTP_USER=
# SMTP account password or 16-character Google App Password
SMTP_PASSWORD=

# ------------------------------------------------------------------------------
# 9. PDF Brochures & Client Offer Dossiers
# ------------------------------------------------------------------------------
# PDF rendering engine: "weasyprint" or "reportlab"
BROCHURE_ENGINE=reportlab
# Automatically fall back to ReportLab if WeasyPrint fails or dependencies are missing
BROCHURE_FALLBACK_TO_REPORTLAB=true
# Force a specific color theme for generated brochures (1 through 7)
BROCHURE_FORCE_THEME=
# Use LLM copywriting to write custom marketing introductions in brochures
BROCHURE_LLM_ENABLED=true
# Claude model used to generate brochure marketing copy
BROCHURE_LLM_MODEL=claude-sonnet-5-5
# Timeout in seconds for brochure copy generation
BROCHURE_LLM_TIMEOUT=25.0
# Maximum tokens generated for brochure marketing text
BROCHURE_LLM_MAX_TOKENS=1200
# Cache lifetime in hours for LLM-generated brochure copywriting
BROCHURE_LLM_CACHE_TTL_HOURS=24.0
# Append an AI transparency footnote to LLM-generated brochure sections
BROCHURE_LLM_FOOTER_NOTE=true

# ------------------------------------------------------------------------------
# 10. Reports & Object Storage (Local / S3 / Cloudinary)
# ------------------------------------------------------------------------------
# Local filesystem directory used to store generated PDF/Excel reports
REPORT_STORAGE_DIR=data/reports
# Set true if REPORT_STORAGE_DIR is mounted on a persistent disk volume
REPORT_PERSISTENT_VOLUME=false
# Number of days to retain generated export files before automatic deletion
REPORT_RETENTION_DAYS=7
# Time-to-live in seconds for signed, temporary report download links
REPORT_SIGNED_LINK_TTL_SEC=600
# Require AWS S3 for report persistence instead of local disk storage
REPORT_REQUIRE_S3=false
# AWS S3 bucket name for report and document storage
AWS_S3_BUCKET=
# AWS access key ID for S3 storage
AWS_ACCESS_KEY_ID=
# AWS secret access key for S3 storage
AWS_SECRET_ACCESS_KEY=
# AWS region for S3 bucket (e.g. eu-central-1)
AWS_DEFAULT_REGION=
# Custom S3-compatible endpoint URL (for Cloudflare R2, MinIO, or Wasabi)
S3_ENDPOINT_URL=
# Hugging Face or custom S3 bucket name
HF_S3_BUCKET=
# Hugging Face or custom S3 endpoint URL
HF_S3_ENDPOINT_URL=
# Hugging Face S3 access key
HF_ACCESS_KEY=
# Hugging Face S3 secret key
HF_SECRET_KEY=
# Cloudinary cloud name for property image CDN hosting
CLOUDINARY_CLOUD_NAME=
# Cloudinary API key for image upload and transformation
CLOUDINARY_API_KEY=
# Cloudinary API secret key
CLOUDINARY_API_SECRET=
# Full Cloudinary environment connection URL (cloudinary://key:secret@cloud_name)
CLOUDINARY_URL=

# ------------------------------------------------------------------------------
# 11. Document Ingestion: Web URLs & Google Drive Folder Import
# ------------------------------------------------------------------------------
# Comma-separated domain allow-list for /ingest-url (empty allows any public domain)
INGEST_ALLOWED_DOMAINS=
# Comma-separated domain block-list rejected by /ingest-url (internal/private domains)
INGEST_BLOCKED_DOMAINS=
# Ignore website robots.txt disallow directives when fetching web property pages
INGEST_IGNORE_ROBOTS=false
# Maximum response body size in bytes accepted by URL fetcher (default: 3MB)
INGEST_MAX_BYTES=3000000
# HTTP network request timeout in seconds when ingesting external web pages
INGEST_TIMEOUT_SEC=10.0
# Maximum external web URLs an admin may ingest per hour
INGEST_MAX_URLS_PER_HOUR=10
# Number of files processed per batch during Google Drive folder ingestion
DRIVE_INGEST_BATCH_SIZE=10
# Maximum batch size limit for Drive folder processing
DRIVE_INGEST_MAX_BATCH_SIZE=25
# Maximum number of files processed within a single Drive folder import job
DRIVE_INGEST_MAX_FILES=1000
# Maximum folder recursion depth during Google Drive scans
DRIVE_INGEST_MAX_DEPTH=10
# Recursively scan subfolders by default during Drive folder imports
DRIVE_INGEST_RECURSIVE_DEFAULT=true
# Maximum size in bytes for a single ingested Drive file (default: 25MB)
DRIVE_INGEST_MAX_FILE_BYTES=26214400
# Timeout in seconds for processing a single file during Drive ingestion
DRIVE_INGEST_FILE_TIMEOUT_SEC=180.0
# Number of concurrent worker threads processing Drive files
DRIVE_INGEST_WORKERS=2
# Max retry attempts for transient file download or parsing failures
DRIVE_INGEST_MAX_ATTEMPTS=3
# Maximum table rows parsed from spreadsheets or CSV files
DRIVE_INGEST_MAX_ROWS=5000
# Maximum pages parsed from PDF documents during ingestion
DRIVE_INGEST_MAX_PDF_PAGES=300
# Maximum property draft listings created from a single ingested file
DRIVE_INGEST_MAX_DRAFTS_PER_FILE=500
# Maximum image dimensions in total pixels allowed during image processing
DRIVE_INGEST_MAX_IMAGE_PIXELS=60000000
# Maximum file count allowed inside ingested ZIP archives
DRIVE_INGEST_ZIP_MAX_MEMBERS=200
# Maximum total uncompressed byte size allowed for ZIP archives (default: 100MB)
DRIVE_INGEST_ZIP_MAX_TOTAL_BYTES=104857600
# Maximum compression ratio allowed for ZIP archives to prevent decompression bombs
DRIVE_INGEST_ZIP_MAX_RATIO=100.0
# Enable Optical Character Recognition (OCR) for scanned PDFs and image brochures
DRIVE_INGEST_OCR_ENABLED=false
# Vision/OCR model identifier used for document OCR parsing
DRIVE_INGEST_OCR_MODEL=
# Maximum document pages sent for OCR processing per file
DRIVE_INGEST_OCR_MAX_PAGES=10
# Timeout in seconds for document OCR requests
DRIVE_INGEST_OCR_TIMEOUT_SEC=90.0
# Use LLM extraction to convert unstructured document text into property schemas
DRIVE_INGEST_LLM_ENABLED=true
# Custom LLM model identifier for Drive document parsing
DRIVE_INGEST_LLM_MODEL=
# Maximum text characters sent to the LLM per document extraction call
DRIVE_INGEST_LLM_MAX_CHARS=40000
# Timeout in seconds for LLM document extraction calls
DRIVE_INGEST_LLM_TIMEOUT_SEC=120.0
# Worker lease lock duration in seconds to prevent concurrent processing of the same job
DRIVE_INGEST_LEASE_SEC=300
# Automatically extract and store property photos discovered in ingested files
DRIVE_INGEST_PHOTOS_ENABLED=false
# Timeout in seconds for photo extraction and upload
DRIVE_INGEST_PHOTO_TIMEOUT_SEC=900.0
# Number of concurrent background workers handling photo uploads
DRIVE_INGEST_PHOTO_WORKERS=6
# Vision model used to classify extracted property photos
PHOTO_EXTRACT_MODEL=
# Automatically resume interrupted Drive ingestion jobs when server starts up
DRIVE_INGEST_RESUME_ON_STARTUP=true
# Allow falling back to in-memory job store if Firestore jobs collection is unreachable
DRIVE_INGEST_ALLOW_MEMORY_STORE=false
