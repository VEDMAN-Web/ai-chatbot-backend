# ==========================================
# Tajlandia.com AI Platform Environment Config
# ==========================================

# 1. Database Configuration
DATABASE_URL=postgresql://postgres:password@127.0.0.1:5432/tajlandia_db
ENVIRONMENT=development

# 2. OpenAI Configuration (Public Discovery Agent) — accuracy over cost/speed
OPENAI_API_KEY=sk-proj-your-openai-api-key
OPENAI_MODEL=gpt-5.5
OPENAI_TEMPERATURE=0.0
OPENAI_TIMEOUT=600

# 3. Anthropic Claude Configuration (Admin Intelligence Agent)
ANTHROPIC_API_KEY=sk-ant-api03-your-anthropic-api-key
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_TEMPERATURE=0.0
ANTHROPIC_TIMEOUT=600

# 3b. Persistence (OFF until explicitly enabled). In-session memory stays ON in code.
ENABLE_LEAD_SAVING=false
ENABLE_CHAT_LOGGING=false
ENABLE_AUDIT_LOGGING=false
SESSION_MEMORY_TURNS=50

# 4. Security & CORS
INTERNAL_API_SECRET=tajlandia-internal-secret-token
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8000","https://tajlandia.com","https://tajlandia.pl","https://thai.estate","https://varsoviaestate.com"]

# 5. Google Maps Platform Integration
# (From Google Cloud Console -> APIs & Services -> Credentials -> Create API Key)
# Enable: Maps JavaScript API, Maps Embed API, Places API (New)
GOOGLE_MAPS_API_KEY=AIzaSy_your_google_maps_api_key

# 6. Gmail Integration (Choose Option A or Option B)
# Option A: Quick SMTP Dispatch (Recommended: 2-minute setup via Google App Password)
# (Google Account -> Security -> 2-Step Verification -> App Passwords -> Generate 16-char password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your_16_char_google_app_password
TAJLANDIA_SALES_EMAIL=sales@tajlandia.com

# Option B: Google Workspace OAuth2 (For team Google Calendar & Gmail API)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# 7. Storage & Embeddings
REPORT_STORAGE_DIR=data/reports
EMBEDDING_DIMENSION=1536

# 8. Dynamic Domain, Website & Branding Configuration (Configure your domain & branding here!)
BASE_WEBSITE_URL=https://varsoviaestate.com/en
DEFAULT_TENANT=varsoviaestate.com
SITE_ORIGIN=varsoviaestate.com
BRAND_NAME=Varsovia Estate
BOT_NAME=Varsovia Estate Advisor
BRAND_TITLE=Varsovia Estate — Premium Thailand Properties
BRAND_SUBTITLE=Exclusive Estates
ADVISOR_EMAIL=advisor@varsoviaestate.com
ADMIN_EMAIL=admin@varsoviaestate.com
SALES_EMAIL=sales@varsoviaestate.com
